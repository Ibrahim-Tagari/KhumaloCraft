        <table class="table">
            <thead>
                <tr>
                    <th>ProductID</th>
                    <th>UserID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>CategoryID</th>
                    <th>action</th>
                </tr>
            </thead>
            <tBody>
                @foreach (var item in Model.listInvoice)
                {
                    <tr>
                        <td>@item.ProductID</td>
                        <td>@item.UserID</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.Price</td>
                        <td>@item.CategoryID</td>
                        <td>
                            <form method="post">
                                <input type="hidden" name="ProductID" value="@item.ProductID" />
                                <input type="submit" value="Add to cart" />
                            </form>
                        </td>
                        <br>
                        <br>
                    </tr>
                }
            </tBody>
        </table>

       
        <br><h3> Invoice <h3>

