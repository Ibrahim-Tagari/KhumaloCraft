@page
@model KhumaloCraftWebApp.Pages.ContactUsPageModel


<!DOCTYPE html>
<html>
<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: white;
    }

    header, nav, main, footer {
        display: block;
    }

    header {
        color: #fff;
        text-align: center;
        padding: 20px;
    }

    nav {
        background-color: #555;
        color: #fff;
        text-align: center;
        padding: 10px;
    }

        nav a {
            color: #fff;
            text-decoration: none;
            margin: 0 10px;
        }

    main {
        padding: 20px;
    }

    h1 {
        color: Black;
        text-align: center;
        font-family: 'Georgia';
        padding-right: 50px;
    }

    h2 {
        text-align: center;
        font-family: 'Bel Air', Serif;
        padding-right: 50px;
    }

    p{
        text-align: center;
        <!-- padding-right: 200px; -->
    }
    footer {
        background-color: white;
        color: black;
        text-align: center;
        padding: 0px;
        <!-- position: fixed; -->
        bottom: 0;
        width: 100%;
    }
</style>
<head>
    <title>KhumaloCraft Emporium - Contact Us</title>
</head>
<body>
    <header>
        <h1>Contact KhumaloCraft Emporium</h1>
    </header>
    <main>
        <h2>Have any questions or inquiries?</h2>
        <p>
            Feel free to reach out to us via email at: khumalocrafts@gmail.com , khumalocraft.com or give us a call at +1234567890.<br>
            Our dedicated team is here to assist you with any queries you may have.<br>
            We value your feedback and look forward to hearing from you!
        </p>

        <center>
            <h3><b> Message Form </b></h3></center>

        <center>
            <div class="form-container">

                <form method="post">
                    <label for="fname">First Name </label>
                    <input type="text" id="fname" name="firstname" /><br><br>

                    <label for="lname">Last Name </label>
                    <input type="text" id="lname" name="lastname" /><br><br>

                    <label for="lname">    Email </label>
                    <input type="text" id="email" name="email" /><br><br>

                    <label for="message">Message </label>
                    <textarea id="message" name="message" style="height:200px"></textarea><br><br>

                    <input type="submit" value="Submit" /><br><br>
                    <input type="reset" value="Reset" /><br><br>


                </form>
            </div>

            @if (Model.hasdata)
            {
                <p><b>Hello</b></p>
                <p>
                    <b>@Model.firstname @Model.lastname</b>
                </p>
                <p>
                    <b>We have received your message as follows: </b>
                </p>
                <p>
                    <b>@Model.message </b>
                </p>
                <p>
                    <b>Thank you</b>
                </p>

            }

        </center>

    </main>
    <footer>
        <p>&copy; 2024 KhumaloCraft Emporium</p>
    </footer>
</body>
</html>

